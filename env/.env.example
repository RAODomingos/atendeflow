ATENDeflow_app_name=OminiDesk
ATENDeflow_app_description=Central de Atendimento Omnichannel
ATENDeflow_app_logo=/assets/img/ominidesk-logo.jpg
ATENDeflow_app_favicon=/assets/img/favicon.png

# Tema
ATENDeflow_primary_color=#4A90D9
ATENDeflow_secondary_color=#28A745
ATENDeflow_dark_mode_enabled=true
ATENDeflow_auto_dark_mode=false
ATENDeflow_theme=light

# Widget de Chat
ATENDeflow_chat_widget_enabled=true
ATENDeflow_widget_position=right
ATENDeflow_widget_title=Atendimento
ATENDeflow_widget_welcome_message=Olá! Como podemos ajudar hoje?
ATENDeflow_widget_greeting_delay=3000
ATENDeflow_widget_prechat_timeout=120000
ATENDeflow_widget_avatar_url=

# Proatividade
ATENDeflow_proactive_chat_enabled=true
ATENDeflow_proactive_chat_delay=30000
ATENDeflow_proactive_chat_message=Posso ajudar? Estou aqui para apoiar.
ATENDeflow_proactive_chat_triggers=idle_time_5min;page_inactivity_30s;scroll_to_bottom;time_on_page_60s

# Escalada Humana
ATENDeflow_human_escalation_enabled=true
ATENDeflow_auto_transfer_timeout=120000
ATENDeflow_max_ai_handling_time=300000

# Performance
ATENDeflow_enable_analytics=false
ATENDeflow_enable_sentiment_analysis=false
ATENDeflow_enable_answer_suggestions=false
ATENDeflow_cache_widget_config=true

# UI/UX
ATENDeflow_sidebar_default_collapsed=false
ATENDeflow_sidebar_mobile_behavior=overlay
ATENDeflow_header_translucent=true
ATENDeflow_show_language_selector=false
ATENDeflow_show_quick_replies=true

# Segurança e Privacidade
ATENDeflow_require_name_prechat=true
ATENDeflow_require_email_prechat=false
ATENDeflow_enable_cookies=true
ATENDeflow_cookie_consent_required=true

# Suporte
ATENDeflow_enable_help_center=true
ATENDeflow_help_center_url=/help
ATENDeflow_show_feedback_widget=true
ATENDeflow_feedback_collection_frequency=never

# Contato
ATENDeflow_show_call_us_widget=false
ATENDeflow_call_us_phone=
ATENDeflow_show_whatsapp_widget=false
ATENDeflow_whatsapp_phone=

# Banco de Dados
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=atendeflow
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# JWT (usado na bridge mobile)
JWT_SECRET=atendeflow-jwt-bridge-secret

# WhatsApp / WAHA
WHATSAPP_PROVIDER=waha
# URL base da API WAHA (ex.: http://localhost:3000)
WAHA_BASE_URL=http://localhost:3000
# API Key do WAHA (gerada automaticamente na inicializacao ou definida via WAHA_API_KEY)
WAHA_API_KEY=

# API/Configuração
ATENDeflow_api_endpoint=
ATENDeflow_api_key=
ATENDeflow_custom_css=
ATENDeflow_custom_js=

# Monitoramento
ATENDeflow_enable_tracking=false
ATENDeflow_tracking_id=
ATENDeflow_enable_error_reporting=true

# Admins que podem editar via painel
ATENDeflow_admin_editors=admin@atendeflow.local,gestor@atendeflow.local