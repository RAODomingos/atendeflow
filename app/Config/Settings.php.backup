<?php

namespace App\Config;

class Settings
{
    private static array $config = [];

    public static function load(): void
    {
        self::$config = self::getDefaultSettings();
        
        // Load from .env file
        try {
            $env = \App\Config\Environment::load();
            foreach ($env as $key => $value) {
                $settingKey = str_replace('ATENDeflow_', '', $key);
                self::$config[$settingKey] = self::parseEnvValue($value);
            }
        } catch (Exception $e) {
            error_log("Error loading environment: " . $e->getMessage());
        }
    }

    public static function get(string $key, $default = null)
    {
        return self::$config[$key] ?? $default;
    }

    public static function set(string $key, $value): void
    {
        self::$config[$key] = $value;
    }

    public static function getAll(): array
    {
        return self::$config;
    }

    private static function parseEnvValue(string $value)
    {
        $value = trim($value);
        if (strtolower($value) === 'true') return true;
        if (strtolower($value) === 'false') return false;
        if (is_numeric($value)) return $value + 0;
        if (str_starts_with($value, '[') && str_ends_with($value, ']')) {
            return json_decode($value, true) ?? $value;
        }
        return $value;
    }

    private static function getDefaultSettings(): array
    {
        return [
            // App Settings
            'app_name' => 'AtendeFlow',
            'app_description' => 'Central de Atendimento Omnichannel',
            'app_logo' => '/assets/img/logo.png',
            'app_favicon' => '/assets/img/favicon.ico',
            
            // Theme Settings
            'primary_color' => '#4A90D9',
            'secondary_color' => '#28A745',
            'dark_mode_enabled' => true,
            'auto_dark_mode' => false,
            'theme' => 'light', // light, dark, auto
            
            // Widget Settings
            'chat_widget_enabled' => true,
            'widget_position' => 'right', // left, right
            'widget_title' => 'Atendimento',
            'widget_welcome_message' => 'Olá! Como podemos ajudar hoje?',
            'widget_greeting_delay' => 3000, // ms
            'widget_prechat_timeout' => 120000, // ms
            'widget_avatar_url' => '',
            
            // Proatividade
            'proactive_chat_enabled' => true,
            'proactive_chat_delay' => 30000, // ms
            'proactive_chat_message' => 'Posso ajudar? Estou aqui para apoiar.',
            'proactive_chat_triggers' => [
                'idle_time_5min',
                'page_inactivity_30s',
                'scroll_to_bottom',
                'time_on_page_60s',
            ],
            
            // Escalada humana
            'human_escalation_enabled' => true,
            'auto_transfer_timeout' => 120000, // ms
            'max_ai_handling_time' => 300000, // ms
            
            // Performance
            'enable_analytics' => true,
            'enable_sentiment_analysis' => true,
            'enable_answer_suggestions' => false, // IA futura
            'cache_widget_config' => true,
            
            // UI/UX
            'sidebar_default_collapsed' => false,
            'sidebar_mobile_behavior' => 'overlay', // overlay, push
            'header_translucent' => true,
            'show_language_selector' => false,
            'show_quick_replies' => true,
            
            // Segurança e Privacidade
            'require_name_prechat' => true,
            'require_email_prechat' => false,
            'enable_cookies' => true,
            'cookie_consent_required' => true,
            
            // Suporte
            'enable_help_center' => true,
            'help_center_url' => '/help',
            'show_feedback_widget' => true,
            'feedback_collection_frequency' => 'never', // never, once, always
            
            // Contato
            'show_call_us_widget' => false,
            'call_us_phone' => '',
            'show_whatsapp_widget' => false,
            'whatsapp_phone' => '',
            
            // API/Configuração
            'api_endpoint' => '',
            'api_key' => '',
            'custom_css' => '',
            'custom_js' => '',
            
            // Monitoramento
            'enable_tracking' => false,
