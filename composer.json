{
    "name": "atendeflow/atendeflow",
    "description": "Central de Atendimento Omnichannel",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "dompdf/dompdf": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8080 -t public",
        "migrate": "php database/migrate.php"
    }
}
